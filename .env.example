# Backend
DATABASE_URL=postgresql+psycopg://sunny:sunny_hq_dev@localhost:5432/studio_sunny_hq
REDIS_URL=redis://localhost:6379/0
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For (login rate limits, session IP).
# Empty = never trust XFF. Include your edge proxy (Vercel/Fly/nginx) in production.
TRUSTED_PROXY_IPS=127.0.0.1,::1
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
# CSRF cookie is ss_csrf; frontend stores the token from login/me JSON and sends X-CSRF-Token.

# Google SSO (optional — Admin → Integrations shows status)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Email for invites / password reset (optional — logs to console when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Studio Sunny HQ <noreply@studiosunny.com>
SMTP_TLS=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Day-to-day workers: npm run worker
# or: docker compose --profile workers up
